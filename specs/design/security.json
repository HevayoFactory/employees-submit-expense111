{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their approval",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "submit", "description": "Create, edit, attach receipts to, submit and withdraw the caller's own claims" },
        { "handle": "review-team", "description": "Claims submitted by the caller's team" },
        { "handle": "approve", "description": "Approve a team member's claim" },
        { "handle": "reject", "description": "Reject a team member's claim" },
        { "handle": "read-all", "description": "Every claim" }
      ]
    },
    {
      "resource": "exports",
      "component": "expense-api",
      "description": "Payroll exports",
      "actions": [
        { "handle": "create", "description": "Export approved claims as a CSV" },
        { "handle": "read", "description": "Every past export" }
      ]
    },
    {
      "resource": "settings",
      "component": "expense-api",
      "description": "Receipt threshold",
      "actions": [
        { "handle": "manage", "description": "Change the receipt threshold" }
      ]
    },
    {
      "resource": "categories",
      "component": "expense-api",
      "description": "Expense categories",
      "actions": [
        { "handle": "manage", "description": "Add or remove expense categories" }
      ]
    },
    {
      "resource": "employees",
      "component": "expense-api",
      "description": "Employee records and reporting lines",
      "actions": [
        { "handle": "read-all", "description": "Every employee" },
        { "handle": "manage", "description": "Set an employee's line manager" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "Everyone who submits expense claims" },
    { "name": "Managers", "description": "Line managers who approve their team's claims" },
    { "name": "Finance", "description": "Finance staff who export approved claims" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits and follows their own claims.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7", "F4.2", "F4.3"],
      "grants": ["claims:read", "claims:submit"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Manager",
      "description": "Reviews, approves or rejects their team's claims.",
      "stories": ["F2.1", "F2.2", "F2.3", "F2.4", "F4.1"],
      "grants": ["claims:review-team", "claims:approve", "claims:reject"],
      "assignTo": ["Managers"]
    },
    {
      "name": "FinanceExporter",
      "description": "The Finance actor: exports approved claims, sets the receipt threshold and categories, and maintains reporting lines.",
      "stories": ["F1.8", "F3.1", "F3.2", "F3.3"],
      "grants": ["claims:read-all", "exports:create", "exports:read", "settings:manage", "categories:manage", "employees:read-all", "employees:manage"],
      "assignTo": ["Finance"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-manager", "roles": ["Manager"] },
    { "username": "test-manager-2", "roles": ["Manager"] },
    { "username": "test-financeexporter", "roles": ["FinanceExporter"] }
  ]
}
